<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }} guide</title>
  <meta name="description" content="{{ summary or site.subtitle }}">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 fill=%27%232563eb%27/%3E%3Ctext x=%2716%27 y=%2723%27 font-size=%2722%27 text-anchor=%27middle%27 font-family=%27Georgia,serif%27 fill=%27%23ffffff%27%3Ei%3C/text%3E%3C/svg%3E">
  <script>
    (function () {
      try {
        var d = document.documentElement;
        var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") d.dataset.theme = t;
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/css/guide.css">
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css">
</head>
<body>
  <header class="top">
    <a class="brand" href="/">{{ site.title }}<span> guide</span></a>
    <span class="spacer"></span>
    <div id="search" class="search"></div>
    <button id="theme-toggle" class="icon-btn" type="button" aria-label="Switch between light and dark theme" title="Switch theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </header>
  <div class="shell">
    <nav class="side" aria-label="Chapters">
      <details class="menu" open>
        <summary>Chapters</summary>
        {% for group in collections.chapters | groupByPart %}
        <section>
          <h2>{{ group.part }} · {{ group.part | partTitle }}</h2>
          <ol>
            {% for c in group.items %}
            <li{% if c.url == page.url %} class="current" aria-current="page"{% endif %}><a href="{{ c.url }}"><span class="num">{{ c.data.part }}.{{ c.data.order }}</span> {{ c.data.title }}</a></li>
            {% endfor %}
          </ol>
        </section>
        {% endfor %}
      </details>
    </nav>
    <main class="page">
      {{ content | safe }}
    </main>
  </div>
  <footer class="foot">
    <a href="{{ site.repo }}">Source on GitHub</a>
  </footer>
  <script src="/pagefind/pagefind-ui.js"></script>
  <script>
    document.getElementById("theme-toggle").addEventListener("click", function () {
      var d = document.documentElement;
      var dark = d.dataset.theme ? d.dataset.theme === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      var next = dark ? "light" : "dark";
      d.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch (e) {}
    });
    if (window.PagefindUI) {
      new PagefindUI({ element: "#search", showImages: false, showSubResults: false, resetStyles: false, translations: { placeholder: "Search the guide" } });
    }
    if (window.matchMedia("(max-width: 900px)").matches) {
      var m = document.querySelector(".menu"); if (m) m.removeAttribute("open");
    }
  </script>
</body>
</html>
